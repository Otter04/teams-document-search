{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RAG common document blocks 1.0.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "record_kind": {
      "enum": [
        "design_example",
        "template",
        "run_result"
      ]
    },
    "doc_id": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "properties": {
        "file_name": {
          "type": "string",
          "minLength": 1
        },
        "format": {
          "enum": [
            "docx",
            "pptx",
            "xlsx",
            "pdf",
            "txt",
            "log"
          ]
        },
        "relative_path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "web_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "encoding": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "file_name",
        "format",
        "relative_path",
        "sha256",
        "web_url",
        "encoding"
      ],
      "additionalProperties": false
    },
    "coverage": {
      "type": "object",
      "properties": {
        "scope": {
          "enum": [
            "full_document",
            "excerpt",
            "template"
          ]
        },
        "unit_inventory_complete": {
          "type": "boolean"
        },
        "units": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "unit_id": {
                "type": "string",
                "minLength": 1
              },
              "loc": {
                "$ref": "#/$defs/loc"
              },
              "required": {
                "type": "boolean"
              },
              "status": {
                "enum": [
                  "pending",
                  "completed",
                  "failed",
                  "excluded"
                ]
              },
              "reason": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "block_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              }
            },
            "required": [
              "unit_id",
              "loc",
              "required",
              "status",
              "reason",
              "block_ids"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "scope",
        "unit_inventory_complete",
        "units"
      ],
      "additionalProperties": false
    },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "run_id": {
            "type": "string",
            "minLength": 1
          },
          "method": {
            "enum": [
              "native_parser",
              "vision_llm",
              "manual_design",
              "template"
            ]
          },
          "implementation": {
            "type": "string",
            "minLength": 1
          },
          "model_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "provider": {
            "type": [
              "string",
              "null"
            ]
          },
          "quantization": {
            "type": [
              "string",
              "null"
            ]
          },
          "prompt_version": {
            "type": [
              "string",
              "null"
            ]
          },
          "input_asset_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "required": [
          "run_id",
          "method",
          "implementation",
          "model_id",
          "provider",
          "quantization",
          "prompt_version",
          "input_asset_ids"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "method": {
                  "const": "vision_llm"
                }
              }
            },
            "then": {
              "properties": {
                "model_id": {
                  "type": "string",
                  "minLength": 1
                },
                "provider": {
                  "type": "string",
                  "minLength": 1
                },
                "prompt_version": {
                  "type": "string",
                  "minLength": 1
                },
                "input_asset_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 1,
                  "uniqueItems": true
                }
              }
            }
          }
        ]
      },
      "minItems": 1
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "asset_id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "page_image",
              "slide_image",
              "embedded_image",
              "region_image"
            ]
          },
          "loc": {
            "$ref": "#/$defs/loc"
          },
          "width": {
            "type": "integer",
            "minimum": 1
          },
          "height": {
            "type": "integer",
            "minimum": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "asset_id",
          "path",
          "kind",
          "loc",
          "width",
          "height",
          "sha256"
        ],
        "additionalProperties": false
      }
    },
    "blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "block_id": {
            "type": "string",
            "minLength": 1
          },
          "parent_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "type": {
            "enum": [
              "heading",
              "paragraph",
              "caption",
              "slide",
              "table",
              "table_row",
              "figure",
              "log_line"
            ]
          },
          "text": {
            "type": "string"
          },
          "loc": {
            "$ref": "#/$defs/loc"
          },
          "heading_path": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "run_ref": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/evidence"
            }
          },
          "claims": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/claim"
            }
          },
          "context_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "content_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "table": {
            "$ref": "#/$defs/table"
          },
          "cells": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/cell"
            },
            "minItems": 1
          },
          "visual": {
            "$ref": "#/$defs/visual"
          },
          "log": {
            "type": "object",
            "properties": {
              "timestamp_raw": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "timezone": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "level": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "error_codes": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              }
            },
            "required": [
              "timestamp_raw",
              "timezone",
              "level",
              "error_codes"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "block_id",
          "parent_id",
          "order",
          "type",
          "text",
          "loc",
          "heading_path",
          "run_ref",
          "evidence",
          "claims",
          "context_ids",
          "content_refs",
          "warnings"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "const": "table"
                }
              }
            },
            "then": {
              "required": [
                "table"
              ]
            },
            "else": {
              "not": {
                "required": [
                  "table"
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "table_row"
                }
              }
            },
            "then": {
              "required": [
                "cells"
              ]
            },
            "else": {
              "not": {
                "required": [
                  "cells"
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "figure"
                }
              }
            },
            "then": {
              "required": [
                "visual"
              ]
            },
            "else": {
              "not": {
                "required": [
                  "visual"
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "log_line"
                }
              }
            },
            "then": {
              "required": [
                "log"
              ]
            },
            "else": {
              "not": {
                "required": [
                  "log"
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "enum": [
                    "table",
                    "slide"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "text": {
                  "const": ""
                }
              }
            }
          }
        ]
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schema_version",
    "record_kind",
    "doc_id",
    "source",
    "coverage",
    "runs",
    "assets",
    "blocks",
    "warnings"
  ],
  "additionalProperties": false,
  "$defs": {
    "bbox": {
      "type": "object",
      "properties": {
        "frame_asset_id": {
          "type": "string",
          "minLength": 1
        },
        "x0": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "y0": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "x1": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "y1": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "precision": {
          "enum": [
            "exact",
            "approximate"
          ]
        }
      },
      "required": [
        "frame_asset_id",
        "x0",
        "y0",
        "x1",
        "y1",
        "precision"
      ],
      "additionalProperties": false
    },
    "loc": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "pdf"
            },
            "page": {
              "type": "integer",
              "minimum": 1
            },
            "bbox": {
              "$ref": "#/$defs/bbox"
            }
          },
          "required": [
            "kind",
            "page"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "pptx"
            },
            "slide": {
              "type": "integer",
              "minimum": 1
            },
            "shape_ids": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1
              },
              "uniqueItems": true
            },
            "bbox": {
              "$ref": "#/$defs/bbox"
            }
          },
          "required": [
            "kind",
            "slide"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "xlsx"
            },
            "sheet": {
              "type": "string",
              "minLength": 1
            },
            "cell_range": {
              "type": "string",
              "minLength": 1
            },
            "bbox": {
              "$ref": "#/$defs/bbox"
            }
          },
          "required": [
            "kind",
            "sheet",
            "cell_range"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "docx"
            },
            "paragraph_index": {
              "type": "integer",
              "minimum": 1
            },
            "table_index": {
              "type": "integer",
              "minimum": 1
            },
            "row_index": {
              "type": "integer",
              "minimum": 1
            },
            "cell_index": {
              "type": "integer",
              "minimum": 1
            },
            "media_part": {
              "type": "string",
              "minLength": 1
            },
            "bbox": {
              "$ref": "#/$defs/bbox"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false,
          "anyOf": [
            {
              "required": [
                "paragraph_index"
              ]
            },
            {
              "required": [
                "table_index"
              ]
            },
            {
              "required": [
                "media_part"
              ]
            }
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "txt"
            },
            "line_start": {
              "type": "integer",
              "minimum": 1
            },
            "line_end": {
              "type": "integer",
              "minimum": 1
            },
            "bbox": {
              "$ref": "#/$defs/bbox"
            }
          },
          "required": [
            "kind",
            "line_start",
            "line_end"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "log"
            },
            "line_start": {
              "type": "integer",
              "minimum": 1
            },
            "line_end": {
              "type": "integer",
              "minimum": 1
            },
            "bbox": {
              "$ref": "#/$defs/bbox"
            }
          },
          "required": [
            "kind",
            "line_start",
            "line_end"
          ],
          "additionalProperties": false
        }
      ]
    },
    "evidence": {
      "type": "object",
      "properties": {
        "evidence_id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "literal",
            "visual_region",
            "native_cell",
            "native_shape",
            "context"
          ]
        },
        "loc": {
          "$ref": "#/$defs/loc"
        },
        "quote": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "evidence_id",
        "kind",
        "loc",
        "quote"
      ],
      "additionalProperties": false
    },
    "claim": {
      "type": "object",
      "properties": {
        "claim_id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "observed",
            "inferred"
          ]
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "claim_id",
        "text",
        "status",
        "evidence_ids"
      ],
      "additionalProperties": false
    },
    "cell": {
      "type": "object",
      "properties": {
        "row": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        },
        "row_span": {
          "type": "integer",
          "minimum": 1
        },
        "column_span": {
          "type": "integer",
          "minimum": 1
        },
        "text": {
          "type": "string"
        },
        "value": {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        "value_status": {
          "enum": [
            "known",
            "blank",
            "unreadable",
            "missing_cache"
          ]
        },
        "formula": {
          "type": [
            "string",
            "null"
          ]
        },
        "number_format": {
          "type": [
            "string",
            "null"
          ]
        },
        "role": {
          "enum": [
            "header",
            "data",
            "unknown"
          ]
        },
        "loc": {
          "$ref": "#/$defs/loc"
        }
      },
      "required": [
        "row",
        "column",
        "row_span",
        "column_span",
        "text",
        "value",
        "value_status",
        "formula",
        "number_format",
        "role",
        "loc"
      ],
      "additionalProperties": false
    },
    "table": {
      "type": "object",
      "properties": {
        "row_count": {
          "type": "integer",
          "minimum": 1
        },
        "column_count": {
          "type": "integer",
          "minimum": 1
        },
        "header_rows": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "uniqueItems": true
        },
        "header_status": {
          "enum": [
            "explicit",
            "inferred",
            "unknown",
            "none"
          ]
        },
        "continued_from": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "row_count",
        "column_count",
        "header_rows",
        "header_status",
        "continued_from"
      ],
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "properties": {
        "node_id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string"
        },
        "loc": {
          "$ref": "#/$defs/loc"
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "node_id",
        "label",
        "loc",
        "evidence_ids"
      ],
      "additionalProperties": false
    },
    "relation": {
      "type": "object",
      "properties": {
        "relation_id": {
          "type": "string",
          "minLength": 1
        },
        "from_node": {
          "type": "string",
          "minLength": 1
        },
        "to_node": {
          "type": "string",
          "minLength": 1
        },
        "direction": {
          "enum": [
            "undirected",
            "forward",
            "bidirectional",
            "unknown"
          ]
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "relation_id",
        "from_node",
        "to_node",
        "direction",
        "label",
        "evidence_ids"
      ],
      "additionalProperties": false
    },
    "visual": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "diagram",
            "photo",
            "chart",
            "other"
          ]
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "relations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relation"
          }
        }
      },
      "required": [
        "kind",
        "nodes",
        "relations"
      ],
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "record_kind": {
            "const": "run_result"
          }
        }
      },
      "then": {
        "properties": {
          "source": {
            "properties": {
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          },
          "coverage": {
            "properties": {
              "scope": {
                "const": "full_document"
              },
              "unit_inventory_complete": {
                "const": true
              }
            }
          },
          "runs": {
            "items": {
              "properties": {
                "method": {
                  "enum": [
                    "native_parser",
                    "vision_llm"
                  ]
                }
              }
            }
          }
        }
      }
    }
  ]
}
