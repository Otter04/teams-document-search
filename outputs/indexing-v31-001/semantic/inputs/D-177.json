      "end": 39,
      "loc": {
        "kind": "docx",
        "table_index": 1,
        "row_index": 2,
        "cell_index": 1
      },
      "section": []
    },
    {
      "id": 5,
      "text": "2\t업무 서비스 이관 작업 가능 시간(야간·주말) 범위",
      "block_id": "D-177-3ee4fccf2268-table1-r3",
