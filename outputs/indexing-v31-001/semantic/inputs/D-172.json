        "cell_index": 1
      },
      "section": []
    },
    {
      "id": 11,
      "text": "필요 대역폭\t최소 400Mbps",
      "block_id": "D-172-00309aad6c69-table1-r4",
      "start": 0,
      "end": 17,
      "loc": {
        "kind": "docx",
